EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported via EXPO_PUBLIC_SUPABASE_ANON_KEY.

# Optional HTTPS raster tile provider; defaults to OSM Deutschland.
# Keep {z}/{x}/{y} placeholders. Provider changes may have their own usage rules.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_CREDIT=OSM Deutschland

# Upload the 8 discovery PNG icons to this public Supabase Storage bucket.
EXPO_PUBLIC_CATEGORY_ICON_BUCKET=category-icons
# Leave empty when files are at the bucket root, or set e.g. food-icons.
EXPO_PUBLIC_CATEGORY_ICON_PREFIX=
