# Copy to .env.properties in ai-service. This file is read by Spring, NOT Expo.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SUPABASE_URL=https://glchegbogadnllehcnzf.supabase.co
SUPABASE_PUBLIC_KEY=
# Server only. Used solely by the incremental indexer, never returned to Expo/Gemini.
SUPABASE_SERVICE_ROLE_KEY=
AI_INDEX_ENABLED=true
AI_INDEX_BATCH_SIZE=5
AI_MIN_SIMILARITY=0.62
AI_INDEX_DELAY_MS=60000
AI_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8093
PORT=3002
