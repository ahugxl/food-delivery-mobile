{
  "expo": {
    "name": "Giao đồ ăn",
    "slug": "food-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "food-delivery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "plugins": ["expo-router", ["expo-location", {"locationWhenInUsePermission": "Cho phép Giao đồ ăn dùng vị trí để chọn điểm giao hàng."}], ["expo-image-picker", {"photosPermission": "Cho phép chọn ảnh đại diện hoặc ảnh gửi trong cuộc trò chuyện.", "cameraPermission": "Cho phép chụp ảnh để gửi trong cuộc trò chuyện đơn hàng.", "microphonePermission": false}]],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
