EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported via EXPO_PUBLIC_SUPABASE_ANON_KEY.

# Optional HTTPS raster tile provider; defaults to OSM's public tile service.
# Keep {z}/{x}/{y} placeholders. Provider changes may have their own usage rules.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_TILE_CREDIT=
